# ==========================================
# StudyCollab - Docker Compose Environment
# ==========================================

# Database
POSTGRES_DB=studycollab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_SECURITY=DEBUG

# App Security & JWT
JWT_SECRET=9a4f2c8d3e1b7a6f5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a21
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Cloudflare R2 / Object Storage (Optional for basic local dev)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend Email Service (Optional for basic local dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
