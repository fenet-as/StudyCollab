### Variables
@baseUrl = http://localhost:8080/api/auth
@email = fenetasmamaw48@gmail.com
@password = Password123!

### 1. Register a new user
# Expects: 200 OK with message "Registration successful!..."
# Check your Resend inbox (or server logs) for the token.
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 2. Login BEFORE Email Verification (Should Fail)
# Expects: 500 or error response saying account is not verified.
#POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 3. Verify Email Token
# Replace YOUR_TOKEN_HERE with the token sent in the email (or copied from email_verification_tokens table)
# Expects: 200 OK with JWT token in body + HttpOnly refreshToken cookie attached automatically.
@verificationToken = YOUR_TOKEN_HERE

GET {{baseUrl}}/verify-email?token={{verificationToken}}

###

### 4. Login AFTER Email Verification
# Expects: 200 OK with AuthResponse (JWT + User info) + HttpOnly refreshToken cookie attached.
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 5. Refresh Access Token
# Automatically sends the HttpOnly cookie received from login/verify step.
# Expects: 200 OK with a new JWT access token + rotated refresh token cookie.
#POST {{baseUrl}}/refresh

###

### 6. Logout
# Revokes the refresh token and clears the cookie.
# Note: Add 'Authorization: Bearer <JWT>' if required by SecurityConfig.
#POST {{baseUrl}}/logout