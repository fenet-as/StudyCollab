# ==============================================================================
# StudyCollab Backend - Production Environment Template (.env.prod.example)
#
# Copy this file to .env.prod and replace placeholders with real secret values.
# NEVER commit .env.prod or real credentials to source control.
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Production Database (e.g. Neon PostgreSQL, AWS RDS)
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# App Security & JWT Configuration
# Note: JWT_SECRET MUST be a cryptographically secure, Base64-encoded key of at least 256 bits (32 bytes).
# Generate via: openssl rand -base64 32
JWT_SECRET=<base64-encoded-32-byte-secret>
JWT_EXPIRATION_MS=900000            # Access token lifetime in milliseconds (15 minutes)
JWT_REFRESH_EXPIRATION_MS=604800000 # Refresh token lifetime in milliseconds (7 days)

# CORS Allowlist (Comma-separated origins for production frontend)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Cloudflare R2 / S3-Compatible Object Storage
R2_ACCESS_KEY=<cloudflare-r2-access-key-id>
R2_SECRET_KEY=<cloudflare-r2-secret-access-key>
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<production-bucket-name>
R2_PUBLIC_URL=https://<public-r2-custom-domain-or-r2.dev>

# Resend Transactional Email Service
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_FROM_EMAIL=noreply@yourdomain.com
